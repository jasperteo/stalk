{
	"nodeModulesDir": "auto",
	"preferPackageJson": true,
	"minimumDependencyAge": 0,

	"tasks": {
		"dev": "deno run -P --env-file=.env src/main.ts",
		"test": "vitest",
		"preview": "deno run -P --env-file=.env scripts/preview.ts",
		"measure": "deno run -P scripts/measure.ts",
		"sync-types": "deno types > deno.d.ts && deno task fmt",
		"fmt": "oxfmt",
		"lint": "oxlint && deno lint && deno check --unstable-tsgo ."
	},

	"compilerOptions": {
		"lib": ["deno.window", "deno.unstable"],

		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,

		"checkJs": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},

	"imports": { "@/": "./src/" },

	"exclude": ["**/.claude/worktrees/"],

	"permissions": {
		"default": {
			"env": { "allow": true },
			"ffi": { "allow": true },
			"net": { "allow": true },
			"read": { "allow": true },
			"write": { "allow": true }
		}
	},

	"lint": { "rules": { "tags": ["recommended"] }, "exclude": ["**/deno.d.ts"] },
	"fmt": { "exclude": ["**/*"] },

	"unstable": ["kv", "cron"],

	"deploy": {
		"install": "deno ci --prod",
		"runtime": { "mode": "dynamic", "entrypoint": "src/main.ts" }
	}
}
