{
	"nodeModulesDir": "auto",
	"preferPackageJson": true,

	"tasks": {
		"dev": "deno watch -A --tunnel src/main.ts",
		"deploy": "deno run -A jsr:@deno/deployctl deploy",
		"test": "vitest",
		"preview": "deno run -A --env-file=.env scripts/preview.ts",
		"measure": "deno run -A scripts/measure.ts",
		"sync-types": "deno types > deno.d.ts && deno task fmt",
		"fmt": "oxfmt",
		"lint": "oxlint && deno lint && deno check --unstable-tsgo ."
	},

	"compilerOptions": {
		"lib": ["deno.window", "deno.unstable"],

		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,

		"checkJs": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},

	"imports": { "@/": "./src/" },

	"exclude": ["**/.claude/worktrees/"],

	"lint": { "rules": { "tags": ["recommended"] }, "exclude": ["**/deno.d.ts"] },
	"fmt": { "exclude": ["**/*"] },

	"unstable": ["kv", "cron"],
	"deploy": { "org": "fi6pv0haybb5d3v4dab39", "app": "stalk" }
}
