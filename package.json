{
	"name": "stalk",
	"type": "module",
	"scripts": {
		"start": "deno run -P --env-file=.env src/main.ts",
		"fmt": "deno run -P npm:oxfmt",
		"lint": "deno run -P npm:oxlint && deno lint && deno check --unstable-tsgo .",
		"lint-agent": "deno run -P npm:oxlint --format=agent && deno lint && deno check --unstable-tsgo .",
		"test": "deno run -P npm:vitest",
		"preview": "deno run -P --env-file=.env scripts/preview.ts",
		"measure": "deno run -P scripts/measure.ts",
		"sync-types": "deno types > deno.d.ts"
	},
	"dependencies": {
		"@std/async": "npm:@jsr/std__async@^1.5.1",
		"@std/fmt": "npm:@jsr/std__fmt@^1.0.10",
		"hono": "^4.13.13",
		"sharp": "^0.35.5",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"vitest": "5.0.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.9.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "deno",
			"version": "2.9.6",
			"onFail": "download"
		}
	}
}
