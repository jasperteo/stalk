# Clash Royale API token from developer.clashroyale.com, created for the RoyaleAPI proxy's IP
# address. Without it the server still starts, but every cron tick is skipped with a warning.
CR_API_TOKEN=
# The players to track: a JSON array with one { tag, webhook } object per player.
# Keep the single quotes. An unquoted value ends at the "#" of the first player tag.
TARGETS='[{"tag":"#PLAYERTAG","webhook":"https://discord.com/api/webhooks/..."}]'
