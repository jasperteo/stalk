# Clash Royale API token (whitelisted to the RoyaleAPI proxy IP)
CR_API_TOKEN=
# JSON array of { tag, webhook } pairs, one per tracked player.
# Must be single-quoted: player tags contain "#", which starts a comment in an unquoted value.
TARGETS='[{"tag":"#PLAYERTAG","webhook":"https://discord.com/api/webhooks/..."}]'
