{
	"nodeModulesDir": "auto",
	"preferPackageJson": true,
	"minimumDependencyAge": 0,

	"tasks": {
		"dev": "deno run -P --env-file=.env src/main.ts",
		"fmt": "oxfmt",
		"lint": "oxlint && deno lint && deno check --unstable-tsgo .",
		"lint-agent": "oxlint --format=agent && deno lint && deno check --unstable-tsgo .",
		"test": "vitest",
		"preview": "deno run -P --env-file=.env scripts/preview.ts",
		"measure": "deno run -P scripts/measure.ts",
		"sync-types": "deno types > deno.d.ts",
	},

	"compilerOptions": {
		"lib": ["deno.window", "deno.unstable"],

		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,

		"checkJs": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
	},

	"imports": { "@/": "./src/" },

	"exclude": ["**/.claude/worktrees/"],

	"permissions": {
		"default": {
			"env": { "allow": true },
			"ffi": { "allow": true },
			"net": {
				"allow": [
					"0.0.0.0:8000",
					"proxy.royaleapi.dev",
					"discord.com",
					"api-assets.clashroyale.com",
				],
			},
			"read": { "allow": true },
			"write": { "allow": true },
		},
	},

	"lint": { "rules": { "tags": ["recommended"] }, "exclude": ["**/deno.d.ts"] },
	"fmt": { "exclude": ["**/*"] },

	"unstable": ["kv", "cron"],

	"deploy": {
		"install": "deno install --prod --entrypoint src/main.ts",
		"runtime": { "mode": "dynamic", "entrypoint": "src/main.ts" },
	},
}
